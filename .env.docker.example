# Copy to .env for local Docker development. Never commit the populated file.
POSTGRES_USER=streamkita
POSTGRES_PASSWORD=change-me
POSTGRES_DB=streamkita_dev
POSTGRES_PORT=5432

API_PORT=3001
WS_PORT=3002
WEBSOCKET_PATH=/socket.io/
JWT_SECRET=generate-a-random-secret-with-at-least-24-characters
ACCOUNT_DELETION_COOLING_OFF_DAYS=7
AUTH_HASH_SECRET=replace-with-an-independent-random-secret
OTP_HASH_SECRET=replace-with-an-independent-random-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_SENDS_PER_HOUR=5
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

WEB_PORT=3000
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:3002
FRONTEND_URL=http://localhost:3000

BACKOFFICE_PORT=3006
BROADCASTER_PORT=3010
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
HLS_BACKEND_PORT=5001
HLS_NGINX_PORT=8089
CDN_BASE_URL=http://localhost:8089

IVS_STREAM_KEY=
IVS_RTMP_URL=
IVS_PLAYBACK_URL=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
