DATABASE_URL=
JWT_SECRET=
PORT=3001
ACCOUNT_DELETION_COOLING_OFF_DAYS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# TMDB API Configuration
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Midtrans Configuration
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Frontend URL for payment callbacks
# Local: http://localhost:5173
# Server: https://smashstream.id
FRONTEND_URL=http://localhost:5173

# Authentication security
AUTH_HASH_SECRET=
OTP_HASH_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_SENDS_PER_HOUR=5
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=admin@smashstream.id
SMTP_FROM_NAME=SMASH
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
# mock is permitted only in NODE_ENV=development/test
AUTH_PROVIDER_MODE=

# Meta WhatsApp Cloud API (backend only)
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_OTP_TEMPLATE_NAME=
META_WHATSAPP_OTP_TEMPLATE_LANGUAGE=
META_WHATSAPP_API_VERSION=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# OAuth/OIDC (secrets remain backend-only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URIS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URIS=

# A transactional email provider and verified sender domain must be selected
# before real email OTP/recovery delivery is enabled.
