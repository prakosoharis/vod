// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  MOVIE
  SERIES
}

enum BackofficeRole {
  SUPERUSER
  ADMIN
  PUBLISHER
}

model Publisher {
  id          String           @id @default(uuid())
  name        String
  address     String           @db.Text
  pic_name    String
  pic_phone   String
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  contents    Content[]
  staff_users BackofficeUser[]

  @@index([name])
  @@map("publishers")
}

model BackofficeUser {
  id            String         @id @default(uuid())
  email         String         @unique
  full_name     String
  password_hash String
  role          BackofficeRole
  publisher_id  String?
  is_active     Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  publisher     Publisher?     @relation(fields: [publisher_id], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([publisher_id])
  @@map("backoffice_users")
}

enum EventType {
  GALA_PREMIERE
  STANDUP_COMEDY
  CONCERT
  SPECIAL_EVENT
}

model User {
  id                         String                   @id @default(uuid())
  email                      String?                  @unique
  email_normalized           String?                  @unique
  email_verified_at          DateTime?
  verification_blocked_until DateTime?
  username                   String?                  @unique
  username_normalized        String?                  @unique
  phone_e164                 String?                  @unique
  phone_verified_at          DateTime?
  password_hash              String?
  account_status             AuthAccountStatus        @default(PENDING_VERIFICATION)
  full_name                  String?
  avatar_url                 String?
  local_avatar_url           String? // For uploaded avatars
  created_at                 DateTime                 @default(now())
  updated_at                 DateTime                 @updatedAt
  deleted_at                 DateTime?
  watchlist                  Watchlist[]
  watch_progress             WatchProgress[]
  subscriptions              UserSubscription[]
  rentals                    UserRental[]
  event_tickets              EventTicket[]
  broadcast_tickets          BroadcastTicket[]
  transactions               Transaction[]
  legal_consents             LegalConsent[]
  support_tickets            SupportTicket[]
  deletion_requests          AccountDeletionRequest[]
  compliance_logs            ComplianceAuditLog[]
  otp_challenges             OtpChallenge[]
  auth_sessions              AuthSession[]
  social_identities          SocialIdentity[]
  login_attempts             LoginAttempt[]

  @@index([email])
  @@index([deleted_at])
  @@map("users")
}

enum AuthAccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}

enum OtpChannel {
  EMAIL
  WHATSAPP
}

enum SocialProvider {
  GOOGLE
  FACEBOOK
}

model OtpChallenge {
  id                  String     @id @default(uuid())
  user_id             String
  purpose             OtpPurpose
  channel             OtpChannel
  destination         String
  destination_hash    String
  otp_hash            String
  expires_at          DateTime
  resend_after        DateTime
  attempts            Int        @default(0)
  max_attempts        Int
  consumed_at         DateTime?
  provider_message_id String?
  is_resend           Boolean    @default(false)
  created_at          DateTime   @default(now())
  user                User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose, consumed_at])
  @@index([destination_hash, purpose, created_at])
  @@index([user_id, purpose, is_resend, created_at])
  @@index([expires_at])
  @@map("otp_challenges")
}

model AuthSession {
  id                 String    @id @default(uuid())
  user_id            String
  refresh_token_hash String    @unique
  device_name        String?
  platform           String
  ip_hash            String?
  user_agent         String?
  expires_at         DateTime
  revoked_at         DateTime?
  replaced_by_id     String?
  created_at         DateTime  @default(now())
  last_used_at       DateTime  @default(now())
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at])
  @@index([expires_at])
  @@map("auth_sessions")
}

model SocialIdentity {
  id               String         @id @default(uuid())
  user_id          String
  provider         SocialProvider
  provider_user_id String
  provider_email   String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  user             User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@unique([user_id, provider])
  @@map("social_identities")
}

model LoginAttempt {
  id              String   @id @default(uuid())
  user_id         String?
  identifier_hash String
  ip_hash         String?
  platform        String
  succeeded       Boolean
  reason          String?
  created_at      DateTime @default(now())
  user            User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([identifier_hash, created_at])
  @@index([ip_hash, created_at])
  @@index([user_id, created_at])
  @@map("login_attempts")
}

enum LegalDocumentType {
  TERMS
  PRIVACY
}

enum SupportTicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum DeletionRequestStatus {
  PENDING
  PROCESSING
  CANCELLED
  COMPLETED
  FAILED
}

model LegalConsent {
  id               String            @id @default(uuid())
  user_id          String
  document_type    LegalDocumentType
  document_version String
  source_platform  String
  accepted_at      DateTime          @default(now())
  user_agent       String?
  user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, document_type, document_version])
  @@index([user_id, accepted_at])
  @@map("legal_consents")
}

model SupportTicket {
  id                 String              @id @default(uuid())
  ticket_number      String              @unique
  user_id            String?
  name               String
  email              String
  phone              String?
  category           String
  transaction_number String?
  subject            String
  message            String              @db.Text
  attachment_url     String?
  status             SupportTicketStatus @default(OPEN)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  user               User?               @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([email, created_at])
  @@index([status, created_at])
  @@map("support_tickets")
}

model AccountDeletionRequest {
  id                    String                @id @default(uuid())
  user_id               String
  status                DeletionRequestStatus @default(PENDING)
  requested_at          DateTime              @default(now())
  scheduled_for         DateTime
  cancelled_at          DateTime?
  completed_at          DateTime?
  processing_started_at DateTime?
  failure_reason        String?
  source_platform       String
  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([status, scheduled_for])
  @@map("account_deletion_requests")
}

model ComplianceAuditLog {
  id              String   @id @default(uuid())
  user_id         String?
  event_type      String
  subject_type    String
  subject_id      String?
  source_platform String?
  metadata        Json?
  created_at      DateTime @default(now())
  user            User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([event_type, created_at])
  @@index([user_id, created_at])
  @@map("compliance_audit_logs")
}

model SupportRateLimitAttempt {
  id         String   @id @default(uuid())
  key_hash   String
  created_at DateTime @default(now())

  @@index([key_hash, created_at])
  @@index([created_at])
  @@map("support_rate_limit_attempts")
}

model Content {
  id                     String      @id @default(uuid())
  title                  String
  description            String?     @db.Text
  genre                  String[]
  year                   Int?
  rating                 Decimal?    @db.Decimal(3, 2)
  duration               String
  thumbnail_url          String
  backdrop_url           String?
  local_thumbnail_url    String? // For uploaded thumbnails
  local_backdrop_url     String? // For uploaded backdrops
  video_url              String?
  trailer_url            String?
  cast                   Json
  type                   ContentType
  featured               Boolean     @default(false)
  show_in_latest         Boolean     @default(false)
  show_in_movie_picks    Boolean     @default(false)
  show_in_popular_series Boolean     @default(false)
  created_at             DateTime    @default(now())
  publisher_id           String?

  // HLS Transcoding Fields
  hls_video_id       String?   @db.Uuid
  hls_url            String?
  hls_cdn_url        String?
  transcoding_status String?   @default("pending")
  transcoded_at      DateTime?

  watchlist      Watchlist[]
  watch_progress WatchProgress[]
  rental_price   RentalPrice?
  rentals        UserRental[]
  episodes       Episode[]
  publisher      Publisher?      @relation(fields: [publisher_id], references: [id], onDelete: SetNull)

  @@index([featured])
  @@index([show_in_latest])
  @@index([show_in_movie_picks])
  @@index([show_in_popular_series])
  @@index([type])
  @@index([hls_video_id])
  @@index([transcoding_status])
  @@index([publisher_id])
  @@map("contents")
}

model Episode {
  id             String   @id @default(uuid())
  content_id     String
  season_number  Int      @default(1)
  episode_number Int
  title          String
  description    String?  @db.Text
  duration       String
  thumbnail_url  String?
  video_url      String?
  hls_url        String?
  is_published   Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  content        Content  @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@unique([content_id, season_number, episode_number])
  @@index([content_id, season_number, episode_number])
  @@map("episodes")
}

model Watchlist {
  id         String   @id @default(uuid())
  user_id    String
  content_id String
  added_at   DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  content    Content  @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@unique([user_id, content_id])
  @@index([user_id, content_id])
  @@map("watchlists")
}

model WatchProgress {
  id               String   @id @default(uuid())
  user_id          String
  content_id       String
  progress_seconds Int
  last_watched     DateTime @default(now())
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  content          Content  @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@unique([user_id, content_id])
  @@map("watch_progress")
}

model LiveEvent {
  id                  String        @id @default(uuid())
  title               String
  description         String?       @db.Text
  event_type          EventType
  scheduled_at        DateTime
  duration_minutes    Int?
  thumbnail_url       String
  backdrop_url        String?
  local_thumbnail_url String?
  local_backdrop_url  String?
  stream_key          String
  host_name           String?
  is_live             Boolean       @default(false)
  ticket_price        Decimal?      @db.Decimal(10, 2) // Harga tiket event (nullable jika gratis)
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
  tickets             EventTicket[]

  @@index([scheduled_at])
  @@index([is_live])
  @@map("live_events")
}

// ============ LIVE STREAMING BROADCAST ============

enum BroadcastStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model BroadcastEvent {
  id             String          @id @default(uuid())
  title          String
  description    String?         @db.Text
  scheduled_time DateTime        @default(now())
  category       String // "Sports", "Music", "Education", "Gaming", etc
  chat_enabled   Boolean         @default(true)
  status         BroadcastStatus @default(SCHEDULED)

  // IVS Credentials (hardcoded from environment)
  stream_key    String
  rtmp_url      String
  playback_url  String
  thumbnail_url String?
  backdrop_url  String?
  ticket_price  Decimal @default(0) @db.Decimal(10, 2)

  viewer_count Int       @default(0)
  started_at   DateTime?
  ended_at     DateTime?
  created_by   String? // Optional: user yang buat event

  // Relationships
  chat_messages ChatMessage[]
  tickets       BroadcastTicket[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([scheduled_time])
  @@index([category])
  @@map("broadcast_events")
}

model ChatMessage {
  id              String  @id @default(uuid())
  broadcast_id    String
  username        String // "Viewer" atau username user (kalau logged in)
  message         String  @db.Text
  is_host_message Boolean @default(false) // True kalau dari broadcaster

  created_at DateTime @default(now())

  // Relationship
  broadcast BroadcastEvent @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)

  @@index([broadcast_id])
  @@index([created_at])
  @@map("chat_messages")
}

// ============ PAYMENT SYSTEM ============

enum PaymentType {
  RENTAL
  SUBSCRIPTION
  EVENT_TICKET
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  FAILED
  EXPIRED
  REFUND
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// Paket subscription
model SubscriptionPlan {
  id            String             @id @default(uuid())
  name          String // "VOD Unlimited"
  description   String?            @db.Text
  price         Decimal            @db.Decimal(10, 2)
  duration_days Int // 30 for monthly
  features      Json // {"vod": true, "live_discount": 0}
  is_active     Boolean            @default(true)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

// User subscriptions
model UserSubscription {
  id           String             @id @default(uuid())
  user_id      String
  plan_id      String
  status       SubscriptionStatus @default(ACTIVE)
  started_at   DateTime           @default(now())
  expired_at   DateTime
  auto_renew   Boolean            @default(true)
  cancelled_at DateTime?
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  user         User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan   @relation(fields: [plan_id], references: [id])
  transactions Transaction[]

  @@index([user_id])
  @@index([status])
  @@map("user_subscriptions")
}

// Harga rental per content
model RentalPrice {
  id             String       @id @default(uuid())
  content_id     String       @unique
  price          Decimal      @db.Decimal(10, 2)
  duration_hours Int // 24 jam
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  content        Content      @relation(fields: [content_id], references: [id], onDelete: Cascade)
  rentals        UserRental[]

  @@map("rental_prices")
}

// User rentals
model UserRental {
  id              String      @id @default(uuid())
  user_id         String
  content_id      String
  rental_price_id String
  rented_at       DateTime    @default(now())
  expired_at      DateTime
  price_paid      Decimal     @db.Decimal(10, 2)
  duration_hours  Int
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  content         Content     @relation(fields: [content_id], references: [id], onDelete: Cascade)
  rental_price    RentalPrice @relation(fields: [rental_price_id], references: [id])
  transaction     Transaction @relation(fields: [transaction_id], references: [id])
  transaction_id  String      @unique

  @@index([user_id, content_id])
  @@index([content_id, rented_at])
  @@index([expired_at])
  @@map("user_rentals")
}

// Event tickets
model EventTicket {
  id             String      @id @default(uuid())
  user_id        String
  event_id       String
  purchased_at   DateTime    @default(now())
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event          LiveEvent   @relation(fields: [event_id], references: [id], onDelete: Cascade)
  transaction    Transaction @relation(fields: [transaction_id], references: [id])
  transaction_id String      @unique

  @@unique([user_id, event_id])
  @@index([user_id])
  @@map("event_tickets")
}

// Broadcast event tickets
model BroadcastTicket {
  id             String         @id @default(uuid())
  user_id        String
  broadcast_id   String
  purchased_at   DateTime       @default(now())
  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  broadcast      BroadcastEvent @relation(fields: [broadcast_id], references: [id], onDelete: Cascade)
  transaction    Transaction    @relation(fields: [transaction_id], references: [id])
  transaction_id String         @unique

  @@unique([user_id, broadcast_id])
  @@index([user_id])
  @@index([broadcast_id])
  @@map("broadcast_tickets")
}

// Unified transaction table
model Transaction {
  id                      String            @id @default(uuid())
  user_id                 String
  order_id                String            @unique // Format: ORD-timestamp-random
  payment_type            PaymentType
  amount                  Decimal           @db.Decimal(10, 2)
  status                  PaymentStatus     @default(PENDING)
  payment_method          String? // gopay, bank_transfer, qris, etc
  midtrans_transaction_id String?           @unique
  midtrans_token          String?
  subscription_id         String?
  metadata                Json? // Store additional info
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt
  user                    User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscription            UserSubscription? @relation(fields: [subscription_id], references: [id])
  rental                  UserRental?
  event_ticket            EventTicket?
  broadcast_ticket        BroadcastTicket?

  @@index([user_id])
  @@index([status])
  @@index([order_id])
  @@map("transactions")
}
